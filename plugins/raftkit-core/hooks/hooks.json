{
  "description": "RaftKit usage telemetry, automatic blocker capture and the SessionStart entry map. Every hook exits 0 unconditionally, so it can never break a session. The telemetry hooks are async except the SessionStart record hook, which runs synchronously because an async hook's stdout is discarded and that would swallow its one-time disclosure notice; the entry map is synchronous for the same reason. The entry map is not telemetry and ignores RAFTKIT_TELEMETRY. Opt out of telemetry with RAFTKIT_TELEMETRY=off.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "session_start"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/flush.mjs"],
            "async": true,
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/entry-map.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "prompt"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "stop"],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "tool_failure"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "skill"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "skill"],
            "async": true,
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "commit"],
            "async": true,
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs", "pr"],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
