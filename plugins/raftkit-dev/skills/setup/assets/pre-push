#!/usr/bin/env sh
# raftkit-governance-pack managed file — rendered by setup's
# scripts/render-assets.mjs from the detected, human-approved toolchain.
# Never hand-edit; re-run setup to update. Repo-specific checks belong
# in your package scripts, not here.
set -e

# Substituted at render time — validated, never invented.
PM="__PM__"
QUALITY_SCRIPTS="__QUALITY_SCRIPTS__"
ABSENT_ROLES="__ABSENT_ROLES__"

fail() { printf '\npre-push blocked: %s\n' "$1" >&2; exit 1; }

# Quality gates — the repo's own approved scripts via the detected manager.
# Absent roles are reported by name, never silently skipped, never invented.
if [ -n "$QUALITY_SCRIPTS" ]; then
  command -v "$PM" >/dev/null 2>&1 || fail "$PM not found on PATH — cannot run the quality gates."
  for role in $ABSENT_ROLES; do
    [ "$role" = "none" ] || printf 'pre-push: role %s has no script in this repo — reported, not run.\n' "$role"
  done
  for gate in $QUALITY_SCRIPTS; do
    printf 'pre-push: running %s...\n' "$gate"
    __PM__ run "$gate" || fail "$gate failed."
  done
fi

exit 0
