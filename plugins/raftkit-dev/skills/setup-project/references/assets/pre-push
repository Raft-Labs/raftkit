#!/usr/bin/env sh
# RaftLabs governance pre-push hook — installed by raftkit-dev/setup-project.
# Managed file: overwritten on the next setup-project run. Put repo-specific
# checks in your package scripts (lint/typecheck/test), not here.
# Runs the four pre-flight gates before any push: spec, lint, typecheck, tests.
set -e

# Substituted from raftkit-core at install time — never hand-edit.
SPEC_PATH="__SPEC_PATH__"
SPEC_TEMPLATE_SENTINEL="__SPEC_TEMPLATE_SENTINEL__"

fail() { printf '\npre-push blocked: %s\n' "$1" >&2; exit 1; }

# 1. Spec gate (Protocol 2): an active-feature spec must exist AND be filled in
# (the untouched template still carries its placeholder sentinel).
[ -f "$SPEC_PATH" ] || fail "no active-feature spec at $SPEC_PATH — write the spec first (Protocol 2)."
if grep -qF "$SPEC_TEMPLATE_SENTINEL" "$SPEC_PATH"; then
  fail "the spec at $SPEC_PATH is still the untouched template — fill it in first (Protocol 2)."
fi

# 2-4. Quality gates. For a Node project (package.json present) the toolchain
# MUST be resolvable and the manifest MUST parse — a missing node/npm or a broken
# package.json fails loudly, never collapses into a silent "no scripts, all clear".
if [ -f package.json ]; then
  command -v node >/dev/null 2>&1 || fail "node not found on PATH — cannot run the quality gates."
  command -v npm  >/dev/null 2>&1 || fail "npm not found on PATH — cannot run the quality gates."
  node -e "JSON.parse(require('fs').readFileSync('package.json','utf8'))" >/dev/null 2>&1 \
    || fail "package.json is not valid JSON — cannot determine the quality gates."

  # node is resolvable and the manifest parses, so this reflects real presence.
  has_script() { node -e "process.exit(((require('./package.json').scripts||{})['$1'])?0:1)"; }
  for gate in lint typecheck test; do
    if has_script "$gate"; then
      printf 'pre-push: running %s...\n' "$gate"
      npm run --silent "$gate" || fail "$gate failed."
    fi
  done
fi

exit 0
